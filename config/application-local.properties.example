# All OpenAI-compatible model calls go through OpenRouter
spring.ai.openai.base-url=https://openrouter.ai/api/v1
spring.ai.openai.api-key=${OPENROUTER_API_KEY}

# Enable embedding-model auto-configuration
spring.ai.model.embedding=openai

# OpenRouter requires the provider-prefixed model identifier
spring.ai.openai.embedding.model=openai/text-embedding-3-small
spring.ai.openai.embedding.dimensions=1536

# Existing database configuration

spring.datasource.url=jdbc:postgresql://localhost:5432/${DB_NAME}
spring.datasource.username=${DATASOURCE_USERNAME}
spring.datasource.password=${DATASOURCE_PASSWORD}
# Do not add metadata to the text sent for embedding.
# Our chunk text already contains document, model, section, and page context.
spring.ai.openai.embedding.metadata-mode=NONE

# PostgreSQL vector-store configuration
spring.ai.vectorstore.pgvector.initialize-schema=true
spring.ai.vectorstore.pgvector.table-name=document_chunk_vectors
spring.ai.vectorstore.pgvector.dimensions=1536
spring.ai.vectorstore.pgvector.distance-type=COSINE_DISTANCE
spring.ai.vectorstore.pgvector.index-type=HNSW
spring.ai.vectorstore.pgvector.max-document-batch-size=64
spring.ai.vectorstore.pgvector.remove-existing-vector-store-table=false

document-assistant.vector-ingestion.input-directory=target/chunk-runs/run-922
